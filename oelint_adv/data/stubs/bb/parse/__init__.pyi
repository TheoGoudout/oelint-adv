# Type stubs for bb.parse
from typing import Any, Callable, Sequence, TypeVar

from bb.data_smart import DataSmart

_F = TypeVar('_F', bound=Callable[..., Any])

class ParseError(Exception):
    msg: str
    filename: str
    lineno: int
    def __init__(self, msg: str, filename: str, lineno: int = ...) -> None: ...

class SkipRecipe(Exception): ...
class SkipPackage(SkipRecipe): ...

def cached_mtime(f: str) -> float: ...
def cached_mtime_noerror(f: str) -> float: ...
def mark_dependency(d: DataSmart, f: str) -> None: ...
def check_dependency(d: DataSmart, f: str) -> bool: ...
def supports(fn: str, data: DataSmart) -> bool: ...
def handle(fn: str, data: DataSmart, include: int = ..., baseconfig: bool = ...) -> Any: ...
def resolve_file(fn: str, d: DataSmart) -> str: ...
def vars_from_file(mypkg: str, d: DataSmart) -> Sequence[str | None]: ...
def get_file_depends(d: DataSmart) -> str: ...
def vardeps(*varnames: str) -> Callable[[_F], _F]: ...
def vardepsexclude(*varnames: str) -> Callable[[_F], _F]: ...
