# Type stubs for bb.build
from typing import Any

from bb import event
from bb.data_smart import DataSmart

class TaskBase(event.Event):
    taskfile: str | None
    taskname: str
    logfile: str | None
    time: float
    pn: str | None
    pv: str | None
    task: str
    def __init__(self, t: str, fn: str, logfile: str | None, d: DataSmart) -> None: ...
    def getTask(self) -> str: ...
    def setTask(self, task: str) -> None: ...
    def getDisplayName(self) -> str: ...

class TaskStarted(TaskBase):
    taskflags: dict[str, Any]
    def __init__(self, t: str, fn: str, logfile: str | None, taskflags: dict[str, Any], d: DataSmart) -> None: ...

class TaskSucceeded(TaskBase): ...

class TaskFailed(TaskBase):
    errprinted: bool
    def __init__(self, task: str, fn: str, logfile: str | None, metadata: DataSmart, errprinted: bool = ...) -> None: ...

class TaskFailedSilent(TaskBase): ...

class TaskInvalid(TaskBase):
    def __init__(self, task: str, fn: str, metadata: DataSmart) -> None: ...

class TaskProgress(event.Event):
    progress: float
    rate: str | None
    def __init__(self, progress: float, rate: str | None = ...) -> None: ...

def exec_func(func: str, d: DataSmart, dirs: list[str] | None = ...) -> None: ...
def exec_func_python(func: str, d: DataSmart, runfile: str, cwd: str | None = ...) -> None: ...
def exec_func_shell(func: str, d: DataSmart, runfile: str, cwd: str | None = ...) -> None: ...
def exec_task(fn: str, task: str, d: DataSmart, profile: bool = ...) -> int: ...
def clean_stamp(task: str, d: DataSmart) -> None: ...
def make_stamp(task: str, d: DataSmart) -> None: ...
def write_taint(task: str, d: DataSmart) -> None: ...
def add_tasks(tasklist: list[str], d: DataSmart) -> None: ...
def addtask(task: str, before: str | None, after: str | None, d: DataSmart) -> None: ...
def deltask(task: str, d: DataSmart) -> None: ...
def preceedtask(task: str, with_recrdeptasks: bool, d: DataSmart) -> set[str]: ...
def tasksbetween(task_start: str, task_end: str, d: DataSmart) -> list[str]: ...
def listtasks(d: DataSmart) -> list[str]: ...
