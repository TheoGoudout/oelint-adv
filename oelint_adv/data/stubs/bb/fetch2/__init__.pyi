# Type stubs for the bitbake fetcher (bb.fetch2, bb.fetch in newer bitbake versions)
from typing import Any, Iterable, Mapping

from bb import event
from bb.data_smart import DataSmart

class BBFetchException(Exception):
    msg: str
    def __init__(self, message: str) -> None: ...

class UntrustedUrl(BBFetchException):
    url: str
    def __init__(self, url: str, message: str = ...) -> None: ...

class MalformedUrl(BBFetchException):
    url: str
    def __init__(self, url: str, message: str = ...) -> None: ...

class FetchError(BBFetchException):
    url: str | None
    def __init__(self, message: str, url: str | None = ...) -> None: ...

class ChecksumError(FetchError):
    checksum: str | None
    def __init__(self, message: str, url: str | None = ..., checksum: str | None = ...) -> None: ...

class NoChecksumError(FetchError): ...

class UnpackError(BBFetchException):
    url: str
    def __init__(self, message: str, url: str) -> None: ...

class NoMethodError(BBFetchException):
    url: str
    def __init__(self, url: str) -> None: ...

class MissingParameterError(BBFetchException):
    url: str
    missing: str
    def __init__(self, missing: str, url: str) -> None: ...

class ParameterError(BBFetchException):
    url: str
    def __init__(self, message: str, url: str) -> None: ...

class NetworkAccess(BBFetchException):
    url: str
    cmd: str
    def __init__(self, url: str, cmd: str) -> None: ...

class NonLocalMethod(Exception): ...

class MissingChecksumEvent(event.Event):
    url: str
    checksums: dict[str, str]
    def __init__(self, url: str, **checksums: str) -> None: ...

class URI:
    scheme: str
    userinfo: str
    username: str
    password: str
    hostname: str
    port: int | None
    path: str
    path_quoted: str
    params: dict[str, str]
    query: dict[str, str]
    @property
    def hostport(self) -> str: ...
    @property
    def relative(self) -> bool: ...
    def __init__(self, uri: str | None = ...) -> None: ...

def decodeurl(url: str) -> tuple[str, str, str, str, str, dict[str, str]]: ...
def encodeurl(decoded: Iterable[Any]) -> str: ...
def fetcher_init(d: DataSmart, servercontext: bool = ...) -> None: ...
def mirror_from_string(data: str | None) -> list[list[str]]: ...
def get_autorev(d: DataSmart) -> str: ...
def get_hashvalue(d: DataSmart, method_name: str = ...) -> str: ...
def get_pkgv_string(d: DataSmart, method_name: str = ...) -> str: ...
def get_srcrev(d: DataSmart, method_name: str = ...) -> str: ...
def localpath(url: str, d: DataSmart) -> str: ...
def get_fetcher_environment(d: DataSmart) -> dict[str, str]: ...
def runfetchcmd(cmd: str, d: DataSmart, quiet: bool = ..., cleanup: list[str] | None = ..., log: Any = ...,
                workdir: str | None = ..., extraenv: Mapping[str, str] | None = ...) -> str: ...
def check_network_access(d: DataSmart, info: str, url: str) -> None: ...
def trusted_network(d: DataSmart, url: str) -> bool: ...
def srcrev_internal_helper(ud: FetchData, d: DataSmart, name: str) -> str: ...
def get_checksum_file_list(d: DataSmart) -> str: ...
def get_file_checksums(filelist: str, pn: str, localdirsexclude: list[str]) -> list[tuple[str, str | None]]: ...

class FetchMethod:
    def supports(self, urldata: FetchData, d: DataSmart) -> bool: ...
    def localpath(self, urldata: FetchData, d: DataSmart) -> str: ...
    def supports_checksum(self, urldata: FetchData) -> bool: ...
    def recommends_checksum(self, urldata: FetchData) -> bool: ...
    def need_update(self, ud: FetchData, d: DataSmart) -> bool: ...
    def try_premirror(self, urldata: FetchData, d: DataSmart) -> bool: ...
    def download(self, urldata: FetchData, d: DataSmart) -> None: ...
    def unpack(self, urldata: FetchData, rootdir: str, data: DataSmart) -> None: ...
    def clean(self, urldata: FetchData, d: DataSmart) -> None: ...
    def checkstatus(self, fetch: Fetch, urldata: FetchData, d: DataSmart) -> bool: ...
    def latest_revision(self, ud: FetchData, d: DataSmart, name: str) -> str: ...
    def sortable_revision(self, ud: FetchData, d: DataSmart, name: str) -> tuple[bool, str]: ...
    def latest_versionstring(self, ud: FetchData, d: DataSmart, filter_regex: str | None = ...) -> tuple[str, str]: ...

class FetchData:
    url: str
    type: str
    host: str
    path: str
    user: str
    pswd: str
    parm: dict[str, str]
    date: str
    name: str
    method: FetchMethod
    localfile: str
    localpath: str | None
    lockfile: str | None
    donestamp: str | None
    basename: str | None
    basepath: str | None
    revision: str | None
    mirrortarballs: list[str]
    ignore_checksums: bool
    def __init__(self, url: str, d: DataSmart, localonly: bool = ...) -> None: ...
    def setup_revisions(self, d: DataSmart) -> None: ...
    def setup_localpath(self, d: DataSmart) -> None: ...
    def getSRCDate(self, d: DataSmart) -> str: ...

class Fetch:
    d: DataSmart
    urls: list[str]
    ud: dict[str, FetchData]
    def __init__(self, urls: list[str], d: DataSmart, cache: bool = ..., localonly: bool = ...,
                 connection_cache: Any = ...) -> None: ...
    def localpath(self, url: str) -> str: ...
    def localpaths(self) -> list[str]: ...
    def download(self, urls: list[str] | None = ...) -> None: ...
    def checkstatus(self, urls: list[str] | None = ...) -> None: ...
    def unpack(self, root: str, urls: list[str] | None = ..., update: bool = ...) -> None: ...
    def clean(self, urls: list[str] | None = ...) -> None: ...
    def expanded_urldata(self, urls: list[str] | None = ...) -> list[FetchData]: ...

methods: list[FetchMethod]
