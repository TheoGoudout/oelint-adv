# Type stubs for the bitbake datastore, the 'd' parameter of python functions
from collections.abc import MutableMapping
from typing import Any, Iterator, Literal, overload

class DataSmart(MutableMapping[str, Any]):
    def __init__(self) -> None: ...
    def enableTracking(self) -> None: ...
    def disableTracking(self) -> None: ...
    def expand(self, s: str | None, varname: str | None = ...) -> str: ...
    def initVar(self, var: str) -> None: ...
    def hasOverrides(self, var: str) -> bool: ...
    def setVar(self, var: str, value: Any, **loginfo: Any) -> None: ...
    def getVar(self, var: str, expand: bool = ..., noweakdefault: bool = ..., parsing: bool = ...) -> str | None: ...
    def renameVar(self, key: str, newkey: str, recurse: bool = ..., **loginfo: Any) -> None: ...
    def appendVar(self, var: str, value: str, **loginfo: Any) -> None: ...
    def prependVar(self, var: str, value: str, **loginfo: Any) -> None: ...
    def delVar(self, var: str, **loginfo: Any) -> None: ...
    def setVarFlag(self, var: str, flag: str, value: Any, **loginfo: Any) -> None: ...
    @overload
    def getVarFlag(self, var: str, flag: str, expand: bool = ..., noweakdefault: bool = ...,
                   parsing: bool = ..., retparser: Literal[False] = ...) -> str | None: ...
    @overload
    def getVarFlag(self, var: str, flag: str, expand: bool = ..., noweakdefault: bool = ...,
                   parsing: bool = ..., *, retparser: Literal[True]) -> tuple[str | None, Any]: ...
    def delVarFlag(self, var: str, flag: str, **loginfo: Any) -> None: ...
    def appendVarFlag(self, var: str, flag: str, value: str, **loginfo: Any) -> None: ...
    def prependVarFlag(self, var: str, flag: str, value: str, **loginfo: Any) -> None: ...
    def setVarFlags(self, var: str, flags: dict[str, Any], **loginfo: Any) -> None: ...
    def getVarFlags(self, var: str, expand: bool | list[str] = ..., internalflags: bool = ...) -> dict[str, Any] | None: ...
    def delVarFlags(self, var: str, **loginfo: Any) -> None: ...
    def createCopy(self) -> DataSmart: ...
    def expandVarref(self, variable: str, parents: bool = ...) -> None: ...
    def setVarFilter(self, var: str, filter: str) -> None: ...
    def localkeys(self) -> Iterator[str]: ...
    def get_hash(self) -> str: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, item: str) -> Any: ...
    def __setitem__(self, var: str, value: Any) -> None: ...
    def __delitem__(self, var: str) -> None: ...
